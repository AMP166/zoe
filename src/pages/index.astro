---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { verifiedFacts, recentResults, recentHighlights } from '../data';
import { getFeaturedPosts, imageSrc } from '../lib/sanity';

const posts = await getFeaturedPosts();
---
<BaseLayout title="Zoe Pedersen | New Zealand Aquablack" description="Zoe Pedersen is a New Zealand Aquablack, World Junior Champion, Commonwealth Games finalist and New Zealand relay record holder.">
  <Header />

  <main>
    <section class="hero section-grid">
      <div class="hero-copy">
        <p class="eyebrow">New Zealand Aquablack · #293</p>
        <h1>Zoe Pedersen</h1>
        <p class="lede">World Junior Champion. Commonwealth Games finalist. New Zealand record holder.</p>
        <p class="hero-body">New Zealand sprint freestyler and butterfly specialist from Coast, racing internationally under coach Michael Weston.</p>
        <div class="hero-actions">
          <a class="button" href="#results">2026 results</a>
          <a class="button secondary" href="#updates">Latest updates</a>
        </div>
      </div>
      <div class="hero-media portrait-frame" aria-label="Zoe Pedersen portrait">
        <img src="/assets/zoe-hero.jpg" alt="Portrait of Zoe Pedersen" />
      </div>
    </section>

    <section class="champion-band" aria-label="Signature achievement">
      <p class="eyebrow">Career marker</p>
      <div class="band-line">
        <strong>{verifiedFacts.heroAchievement.title}</strong>
        <span>{verifiedFacts.heroAchievement.event}</span>
        <span>{verifiedFacts.heroAchievement.result}</span>
        <span>{verifiedFacts.heroAchievement.note}</span>
      </div>
    </section>

    <section class="detail-ledger" aria-label="Athlete details">
      <div class="ledger-row"><span>Club</span><strong>{verifiedFacts.club}</strong></div>
      <div class="ledger-row"><span>Coach</span><strong>{verifiedFacts.coach}</strong></div>
      <div class="ledger-row"><span>Stroke</span><strong>{verifiedFacts.strokes}</strong></div>
      <div class="ledger-row"><span>Aquablack</span><strong>#{verifiedFacts.aquablackNumber}</strong></div>
    </section>

    <section class="results-section" id="results">
      <div class="results-intro">
        <div>
          <p class="eyebrow">2026 season</p>
          <h2>From Glasgow to Pan Pacs to national titles.</h2>
        </div>
        <p>Zoe’s first Commonwealth Games campaign was followed by a Pan Pacific final and a New Zealand relay record, before she returned home to win three individual titles at the 2026 New Zealand Short Course Championships.</p>
      </div>

      <div class="results-ledger">
        {recentResults.map((meet) => (
          <article class="meet-block">
            <header class="meet-head">
              <div>
                <span class="result-kicker">{meet.label}</span>
                <h3>{meet.meet}</h3>
              </div>
              <div class="meet-meta">
                <strong>{meet.headline}</strong>
                <span>{meet.date} · {meet.location}</span>
              </div>
            </header>
            <div class="meet-events">
              {meet.events.map((item) => (
                <div class="result-row">
                  <span class="result-event">{item.event}</span>
                  <strong>{item.result}</strong>
                  <span class="result-detail">{item.detail}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="record-band" aria-label="New Zealand relay record">
      <p class="eyebrow">National record</p>
      <div class="record-line">
        <strong>{verifiedFacts.nationalRecord.event}</strong>
        <span>{verifiedFacts.nationalRecord.result}</span>
        <span>{verifiedFacts.nationalRecord.note}</span>
      </div>
    </section>

    <section class="story-section" id="about">
      <div class="story-head">
        <p class="eyebrow">About Zoe</p>
        <h2>Built for championship moments.</h2>
      </div>

      <figure class="story-feature-image">
        <img src="/assets/zoe-race.jpg" alt="Zoe Pedersen after racing" />
      </figure>

      <div class="story-text-grid">
        <p>Zoe Pedersen is a New Zealand Aquablack from Coast, specialising in sprint freestyle and butterfly under coach Michael Weston.</p>
        <p>In 2026 she finished fifth in the Commonwealth Games 50m butterfly final, seventh at the Pan Pacific Championships and helped New Zealand break the long-course 4×100m freestyle relay record.</p>
        <p>She also competes in surf lifesaving for Red Beach SLSC and holds Youth World Record marks in the 50m Manikin Carry and 100m Rescue Medley.</p>
      </div>

      <div class="highlight-ledger" aria-label="Other 2026 highlights">
        {recentHighlights.map((item) => (
          <div class="highlight-row">
            <strong>{item.title}</strong>
            <span>{item.detail}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="gallery-section">
      <div class="section-heading row-heading">
        <div>
          <p class="eyebrow">Gallery</p>
          <h2>Poolside, race day, podium.</h2>
        </div>
      </div>
      <div class="gallery-grid-alt">
        <figure class="gallery-panel wide-panel">
          <img src="/assets/zoe-podium.jpg" alt="Zoe Pedersen at an awards event" />
        </figure>
        <figure class="gallery-panel tall-panel">
          <img src="/assets/zoe-poolside.jpg" alt="Zoe Pedersen poolside" />
        </figure>
      </div>
    </section>

    <section class="sponsor-section" id="partners">
      <div class="sponsor-copy">
        <p class="eyebrow">Sponsor</p>
        <h2>Proudly supported by FINIS.</h2>
        <p>Performance swimwear and training equipment supporting Zoe in training and competition.</p>
      </div>
      <a class="sponsor-lockup" href="https://www.finisswim.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit FINIS">
        <span class="sponsor-fallback" aria-hidden="true">FINIS®</span>
        <img
          src="https://cdn.bfldr.com/I6FML9WY/at/pgm3cy-3os8qg-bea1w5/finis-logo?auto=webp&format=jpg"
          alt="FINIS"
          loading="lazy"
          referrerpolicy="no-referrer"
          onerror="this.style.display='none'"
        />
      </a>
    </section>

    <section class="instagram-section" id="instagram">
      <div class="section-heading row-heading">
        <div>
          <p class="eyebrow">Instagram</p>
          <h2>Follow Zoe</h2>
        </div>
        <a href={verifiedFacts.socials.instagram} class="text-link" target="_blank" rel="noopener">Open Instagram →</a>
      </div>

      <div class="insta-marquee" aria-label="Zoe Pedersen photo slideshow">
        <div class="insta-track">
          <figure><img src="/assets/zoe-hero.jpg" alt="Zoe Pedersen portrait" /></figure>
          <figure><img src="/assets/zoe-race.jpg" alt="Zoe Pedersen after racing" /></figure>
          <figure><img src="/assets/zoe-poolside.jpg" alt="Zoe Pedersen poolside" /></figure>
          <figure><img src="/assets/zoe-podium.jpg" alt="Zoe Pedersen at an awards event" /></figure>
          <figure><img src="/assets/zoe-gold-graphic.jpg" alt="Zoe Pedersen gold result graphic" /></figure>
          <figure><img src="/assets/zoe-hero.jpg" alt="Zoe Pedersen portrait" /></figure>
          <figure><img src="/assets/zoe-race.jpg" alt="Zoe Pedersen after racing" /></figure>
          <figure><img src="/assets/zoe-poolside.jpg" alt="Zoe Pedersen poolside" /></figure>
          <figure><img src="/assets/zoe-podium.jpg" alt="Zoe Pedersen at an awards event" /></figure>
          <figure><img src="/assets/zoe-gold-graphic.jpg" alt="Zoe Pedersen gold result graphic" /></figure>
        </div>
      </div>
    </section>

    <section class="updates-section" id="updates">
      <div class="section-heading row-heading">
        <div>
          <p class="eyebrow">Updates</p>
          <h2>Latest from Zoe</h2>
        </div>
        <a href="/blog" class="text-link">All updates →</a>
      </div>
      <div class="post-grid">
        {posts.map((post: any) => (
          <a class="post-card" href={`/blog/${post.slug}`}>
            <img src={imageSrc(post, '/assets/zoe-race.jpg')} alt={post.title} />
            <div>
              <span>{post.category} · {post.location}</span>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="contact-section" id="contact">
      <p class="eyebrow">Contact</p>
      <h2>Media, sponsors & enquiries</h2>
      <p>For media, sponsorship or supporter enquiries, contact Zoe’s team.</p>
      <a class="button" href="mailto:zmpedersen1@gmail.com">Email Zoe’s team</a>
    </section>
  </main>

  <Footer />
</BaseLayout>
